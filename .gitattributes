* text=auto

*.bat eol=crlf
*.eml eol=crlf
*.jar binary
# Run by bash, which a CRLF line ending breaks.
scripts/check-before-push.sh eol=lf
scripts/install-git-hooks.sh eol=lf
scripts/git-hooks/* eol=lf
# Compared byte for byte with the badging the build writes, which has LF line endings on every OS.
app-*/badging/*.txt eol=lf

app-k9mail/build.gradle.kts merge=merge_gradle
app-thunderbird/build.gradle.kts merge=merge_gradle
# Changelog histories are branch-owned. Keep the destination's files during merges.
app-thunderbird/src/daily/res/raw/changelog_index.json merge=ours
app-thunderbird/src/daily/res/raw/changelog_release_*.json merge=ours
app-thunderbird/src/beta/res/raw/changelog_index.json merge=ours
app-thunderbird/src/beta/res/raw/changelog_release_*.json merge=ours
app-thunderbird/src/release/res/raw/changelog_index.json merge=ours
app-thunderbird/src/release/res/raw/changelog_release_*.json merge=ours
app-k9mail/src/release/res/raw/changelog_index.json merge=ours
app-k9mail/src/release/res/raw/changelog_release_*.json merge=ours
