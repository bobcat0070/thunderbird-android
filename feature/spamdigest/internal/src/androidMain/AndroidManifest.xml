<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name="net.thunderbird.feature.spamdigest.internal.SpamDigestAlarmReceiver"
            android:exported="false"
            />

        <!-- Disabled until the digest is turned on; the scheduler switches it. -->
        <receiver
            android:name="net.thunderbird.feature.spamdigest.internal.SpamDigestBootReceiver"
            android:enabled="false"
            android:exported="false"
            >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
