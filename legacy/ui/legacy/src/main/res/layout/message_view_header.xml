<?xml version="1.0" encoding="utf-8"?>
<com.fsck.k9.view.MessageHeader
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/header_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <com.google.android.material.chip.Chip
            android:id="@+id/account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:clickable="false"
            android:paddingVertical="4sp"
            android:textColor="@android:color/white"
            app:chipMinHeight="0dp"
            app:ensureMinTouchTargetSize="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:textEndPadding="6sp"
            app:textStartPadding="8sp"
            tools:chipBackgroundColor="#1976D2"
            tools:text="Account name"
            />

        <com.fsck.k9.ui.helper.BottomBaselineTextView
            android:id="@+id/subject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/account_name"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="16dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            app:layout_goneMarginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/flagged"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_name"
            app:layout_constraintVertical_bias="0.0"
            tools:text="Message subject"
            />

        <ImageView
            android:id="@+id/flagged"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="?attr/controlBackground"
            android:baseline="33dp"
            android:paddingHorizontal="12dp"
            android:src="@drawable/btn_select_star"
            app:layout_constraintBaseline_toBaselineOf="@+id/subject"
            app:layout_constraintEnd_toEndOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- How important the sender marked the message and the categories the server keeps on it. Hidden for a
         message with neither. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/message_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:background="?attr/selectableItemBackground"
        android:lineSpacingExtra="6dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:visibility="gone"
        tools:text="High importance"
        tools:visibility="visible"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/participants_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        >

        <!-- Not a circle-cropping view: a logo is shown square, whole, with its verification badge in the
             corner. The initials tile arrives already round, so the shape itself says which one this is. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/contact_picture"
            android:scaleType="centerCrop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_account_circle"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@+id/date"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sender name"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:ellipsize="none"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintBaseline_toBaselineOf="@+id/from"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/from"
            tools:text="Sep 19"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/mark_verification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/from"
            tools:text="Verified brand"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/impersonation_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/mark_verification"
            tools:text="Possible impersonation: paypa1.com is made to look like paypal.com"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/blocklist_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/impersonation_warning"
            tools:text="Sent from tracker.example, which is on HaGeZi's Normal blocklist"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/plus_address_leak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/blocklist_note"
            tools:text="Sent to you+shop@example.com, which you gave to shop.example, not other.example"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/claims_from_you"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/plus_address_leak"
            tools:text="Claims to be from you, but your mail server found it was not sent by example.com"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/security_alert_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_security"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/claims_from_you"
            tools:text="Password reset at lumen.example. If you didn't ask for it, go to lumen.example yourself, not through this mail's links."
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/risky_attachment_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/security_alert_note"
            tools:text="Risky attachment: invoice.html opens as a web page, the way fake sign-in pages are sent."
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/breach_notice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_security"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/risky_attachment_note"
            tools:text="Data breach notice from lumen.example. Change your password there, and wherever you used the same one."
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/reply_to_warning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_reply"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/breach_notice"
            tools:text="Replies go to billing@freemail.example, not supplier.example"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/still_mailing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_warning"
            app:drawableTint="?attr/colorError"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/reply_to_warning"
            tools:text="You unsubscribed on Nov 3 - 18 days ago"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/first_time_sender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:drawablePadding="4dp"
            android:maxLines="2"
            android:text="@string/message_view_first_time_sender"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_person_add"
            app:drawableTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/still_mailing"
            tools:text="First mail from this address"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/verification_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="32dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_content_copy"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/first_time_sender"
            tools:text="Copy code 482913"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/sign_in_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:minHeight="32dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_login"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/verification_code"
            tools:text="Open sign-in link"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tracking_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:minHeight="32dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_local_shipping"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/sign_in_link"
            tools:text="Track UPS package 1Z999AA10123456784"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/qr_code_link"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackground"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:minHeight="32dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_link"
            app:drawableTint="?attr/colorPrimary"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/tracking_number"
            tools:text="QR code in this message opens example.com"
            tools:visibility="visible"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/delivered_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:layout_constraintTop_toBottomOf="@+id/qr_code_link"
            tools:text="to felix+shopping@example.com"
            tools:visibility="visible"
            />

        <ImageView
            android:id="@+id/crypto_status_icon"
            android:layout_width="18sp"
            android:layout_height="18sp"
            android:layout_marginStart="16dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/recipients"
            app:layout_constraintStart_toEndOf="@id/contact_picture"
            app:srcCompat="@drawable/ic_no_encryption"
            app:tint="?attr/openpgp_grey"
            tools:visibility="visible"
            />

        <com.fsck.k9.ui.messageview.RecipientNamesView
            android:id="@+id/recipients"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/menu_primary_action"
            app:layout_constraintStart_toEndOf="@id/crypto_status_icon"
            app:layout_constraintTop_toBottomOf="@+id/delivered_to"
            app:layout_constraintVertical_bias="0.0"
            app:layout_goneMarginStart="16dp"
            />

        <ImageView
            android:id="@+id/menu_primary_action"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/controlBackground"
            android:contentDescription="@string/reply_action"
            android:paddingHorizontal="12dp"
            app:layout_constraintEnd_toStartOf="@id/menu_overflow"
            app:layout_constraintTop_toTopOf="@+id/menu_overflow"
            tools:srcCompat="@drawable/ic_reply_all"
            />

        <ImageView
            android:id="@+id/menu_overflow"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/controlBackground"
            android:clickable="true"
            android:contentDescription="@string/abc_action_menu_overflow_description"
            android:focusable="true"
            android:paddingStart="6dp"
            android:paddingEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_more_vert"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/attachment_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible"
        >

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_attachment"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@null"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/attachment_summary_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3 Attachments (1.5 MB)"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/view_all_attachments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            tools:text="View all"
            />

    </LinearLayout>

</com.fsck.k9.view.MessageHeader>
